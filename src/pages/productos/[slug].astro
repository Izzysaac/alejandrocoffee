---
import data from "@public/data.json";

import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import ImageCarousel from "@components/ImageCarousel.astro";

import BulletPointsAstroComponent from "@components/productPage/BulletPoints.astro";
import MainReviewAstroComponent from "@components/productPage/MainReview.astro";
import PaymentMethodsAstroComponent from "@components/productPage/PaymentMethods.astro";
import FAQSAstroComponent from "@components/productPage/FAQS.astro";
import OrderTimeline from "@components/productPage/OrderTimeline.astro";
import ReviewsAstroComponent from "@components/Reviews.astro";

import { getCldImageUrl } from 'astro-cloudinary/helpers';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);


const { item } = Astro.props;

const seo = {
	title: `${item.nombre} - Parrillas y Defensas para Moto`,
	description: `${item.nombre}, ${item.categoria} - Parrillas y Defensas para Moto`,
	image: `${getCldImageUrl({ src: item.media[0]})}`,
	productSchema: {
		'@context': 'https://schema.org',
		"@graph": [
			{
				'@type': 'Product',
				"@id": `${canonicalURL.href}/#product`,
				name: item.nombre,
				image: `${getCldImageUrl({ src: item.media[0]})}`,
				description: item.categoria,
				sku: item.variantes[0].sku,
				offers: {
					'@type': 'Offer',
					"availability": "https://schema.org/InStock",
					priceCurrency: "COP",
					price: item.variantes[0].precio.toString(),
					url: canonicalURL.href,
				}
			},
			{
				"@type": "BreadcrumbList",
				"@id": `${canonicalURL.href}/#breadcrumb`,
				"itemListElement": [
					{
						"@type": "ListItem",
						"position": 1,
						"name": "Inicio",
						"item": "https://parrillasydefensas.com/"
					},
					{
						"@type": "ListItem",
						"position": 2,
						"name": "Catálogo",
						"item": "https://parrillasydefensas.com/productos/"
					},
					{
						"@type": "ListItem",
						"position": 3,
						name: item.nombre,
					}
				]
			}
		]
	}
};

const productId = item.nombre
	.toLowerCase()
	.normalize("NFD")
	.replace(/[\u0300-\u036f]/g, "")
	.replace(/\s+/g, "-")
	.replace(/[^a-z0-9-]/g, "");

export function getStaticPaths() {
	return data.map((item) => ({
		params: {
			slug: item.nombre
				.toLowerCase()
				.normalize("NFD")
				.replace(/[\u0300-\u036f]/g, "")
				.replace(/\s+/g, "-")
				.replace(/[^a-z0-9-]/g, ""),
		},
		props: { item },
	}));
}
---

<Layout title={seo.title} description={seo.description} schema={seo.productSchema} image={seo.image}>
	<!-- <Breadcrumb class="pt-23 px-2.5" items={[{name:"Productos", href:"/productos/"},{name: item.nombre}]} /> -->
	<main class=" pt-23 flex flex-col text-center gap-2 max-w-125 m-auto!">
		<ImageCarousel name={item.nombre} description={item.descripcion} media={item.media}/>
		<div class="flex flex-col gap-4 px-2.5 max-w-100 m-auto">

			<div style="display: none;" id="product-data">
				{JSON.stringify(item)}
			</div>

			<h1 class="text-2xl font-bold mt-2">{item.nombre}</h1>

			<BulletPointsAstroComponent />

			{
				item.descripcion && (
					<p class="text-sm">{item.descripcion}</p>
				)
			}
			
			<!-- PRECIO dinámico -->
			<p>
				<data id="price" class="font-bold text-lg" value=`${item.variantes?.[0]?.precio}`>${item.variantes?.[0]?.precio.toLocaleString("es-CO")}</data>
			</p>


			<form id="form" class="text-left">

			{
				Object.entries(item.opciones || {}).map(([opcion, valores]) => (	
					<fieldset class="flex flex-col gap-2">
						<legend class="font-semibold capitalize">
							{opcion}
						</legend>

						<div class="flex gap-4">
							{
								(valores as string[]).map((valor, i) => (
									<div>
										<input
											type="radio"
											id={`${opcion}-${valor}`}
											name={opcion}
											value={valor}
											checked={i === 0}
										/>
										<label for={`${opcion}-${valor}`}>
											{valor}
										</label>
									</div>
								))
							}
						</div>
					</fieldset>
				))
			}

			</form>

			<button
				id="add-to-cart"
				type="button"
				data-id={productId}
				data-title={item.nombre}
				data-image={item.media?.[0] ?? ""}
				class="bg-(--accent) text-(--on-accent) active:bg-(--brand-hover) font-bold py-2 px-4 rounded text-lg"
			>
				Añadir al carrito
			</button>

			<PaymentMethodsAstroComponent />

			<MainReviewAstroComponent />

			<OrderTimeline/>

			<ReviewsAstroComponent />

			{
			item.detalles && (
				<>
					<h2 class="text-xl font-bold">
						Detalles
					</h2>

					<p class="whitespace-pre-line text-left">
						{item.detalles}
					</p>
				</Order>
			)
			}

		</div>

		<FAQSAstroComponent />


	</main>
</Layout>

<script is:inline>
	const item = JSON.parse(document.getElementById("product-data").textContent);
	const priceElement = document.getElementById("price");
	const addToCartButton = document.getElementById("add-to-cart");

	const getSelectedOptions = () => {
		const selected = {};
		Object.keys(item.opciones || {}).forEach(opcion => {
			const input = document.querySelector(
				`input[name="${opcion}"]:checked`
			);
			if (input) {
				selected[opcion] = input.value;
			}
		});
		return selected;
	};

	const findVariant = () => {
		const selected = getSelectedOptions();
		return item.variantes.find(v =>
			Object.entries(selected).every(
				([key, value]) => v[key] === value
			)
		);
	}

	const updatePrice = () => {
		const variant = findVariant();

		if (!variant) return;

		priceElement.textContent = "$" + variant.precio.toLocaleString("es-CO");

		addToCartButton.dataset.price = variant.precio;
		addToCartButton.dataset.sku = variant.sku;
	}

	document.querySelectorAll("input[type=radio]").forEach(input =>
		input.addEventListener("change", updatePrice)
	);

	updatePrice();
</script>

<script src="../../scripts/addCart.js"></script>
