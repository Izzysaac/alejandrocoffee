---
import Layout from "../layouts/Layout.astro";
import BestSellers from "@components/BestSellers.astro";
import Reviews from "@components/Reviews.astro";
import FAQS from "@components/productPage/FAQS.astro";

const images = {
	hero: "https://res.cloudinary.com/dr5knskbb/image/upload/v1783319098/bg-parillasydefensas_tnfgjg.webp",

};
// CollectionPage + ItemList + BreadcrumbList
const seo = {
	title: "Parrillas y Defensas para Moto",
	description:
		"Encuentra la parrilla y defensa perfecta para tu moto. Fabrica y venta de lujos y accesorios para motos."
};
---

<Layout title={seo.title} description={seo.description} hero={images.hero}>
	<div
		id="hero"
		style={`background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.3)), url(${images.hero});`}
		class="background-image m-auto flex min-h-full max-w-120 flex-col items-center pb-4 text-white"
	>
		<h1
			class="mt-[30%] block w-full bg-black/50 text-center text-2xl font-bold"
		>
			<span>Las Mejores Parrillas y Defensas</span><br />
			<span>Para Moto en Colombia</span>
		</h1>
		<p class="block w-full bg-black/50 text-center">
			Más protección. Más capacidad. Más utilidad
		</p>

		<div class="mt-auto mb-20 flex w-full flex-col gap-4 px-5 text-center">
			<a
				href="/productos"
				class="block rounded bg-(--accent) px-5 py-2 text-lg font-semibold text-(--on-accent)"
				>Ver catálogo</a
			>
			<p>
				Llevo más de tres años con ella y sigue como el primer día -
				⭐⭐⭐⭐⭐
			</p>
		</div>
	</div>

	<div
		class="flex items-center justify-center gap-4 bg-black py-6 text-center text-sm text-white/80"
	>
		<p class="flex flex-1 flex-col items-center justify-center gap-2">
			<span
				><svg
					viewBox="0 0 16 16"
					fill="currentColor"
					xmlns="http://www.w3.org/2000/svg"
					width="40px"
					height="40px"
					><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
						id="SVGRepo_tracerCarrier"
						stroke-linecap="round"
						stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier">
						<path
							d="M10 3.5L13.0581 0.441881C12.4304 0.15802 11.7337 0 11 0C8.23858 0 6 2.23858 6 5C6 5.45802 6.06158 5.90165 6.17692 6.32308L0 12.5L3.5 16L9.67692 9.82308C10.0983 9.93842 10.542 10 11 10C13.7614 10 16 7.76142 16 5C16 4.26633 15.842 3.56956 15.5581 2.94188L12.5 6H10V3.5Z"
							fill="#currentColor"></path>
					</g></svg
				></span
			>
			<span></span>
			<span>
				Somos <br /> fabricantes
			</span>
		</p>
		<p class="flex flex-1 flex-col items-center justify-center gap-2">
			<span
				><svg
					fill="currentColor"
					width="40px"
					height="40px"
					version="1.1"
					id="Capa_1"
					xmlns="http://www.w3.org/2000/svg"
					xmlns:xlink="http://www.w3.org/1999/xlink"
					viewBox="0 0 370.04 370.04"
