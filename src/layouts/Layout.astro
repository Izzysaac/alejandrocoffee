---
import NavMenu from "@components/NavMenu.astro";
import CartDialog from "@components/cart/CartDialog.astro";
import AnnouncementBar from "@components/AnnouncementBar.astro";

import Footer from "@components/Footer.astro";

import Schemas from "@components/seo/Schemas.astro";
import SpeedInsights from "@vercel/speed-insights/astro"
import Analytics from '@vercel/analytics/astro'

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { index = true, title, description, schema, image = "https://res.cloudinary.com/dr5knskbb/image/upload/v1782964448/parrillasydefensas-logo_hbl6be.webp", hero = false } = Astro.props;

const schemas = schema
    ? Array.isArray(schema)
        ? schema
        : [schema]
    : [];

const OrganizationSchema = {
	"@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Organization",
            "@id": "https://parrillasydefensas.com/#organization",
            name: "parrillasydefensas",
            url: "https://parrillasydefensas.com",
            logo: "https://parrillasydefensas.com/logo.webp",
            sameAs: [
                "https://www.instagram.com/parrillasydefensas/",
                "https://www.facebook.com/parrillasydefensasmoto/",
            ],
        },
        {
            "@type": "WebSite",
            "@id": "https://parrillasydefensas.com/#website",
            url: "https://parrillasydefensas.com/",
            name: "Parrillas y Defensas para Moto",
            description: "Encuentra la parrilla y defensa perfecta para tu moto. Fabrica y venta de lujos y accesorios para motos.",
			image: "https://parrillasydefensas.com/logo.webp",
            publisher: {
                "@id": "https://parrillasydefensas.com/#organization",
            },
        },
        {
            "@type": "WebPage",
            "@id": `${canonicalURL.href}/#webpage`,
            url: `${canonicalURL.href}`,
            name: `${title}`,
            description: `${description}`,
			image:  `${image}`,
            isPartOf: {
                "@id": "https://parrillasydefensas.com/#website",
            },
            about: {
                "@id": "https://parrillasydefensas.com/#organization",
            },
        },
    ],
}

---

<!doctype html>
<html lang="es-CO">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="preconnect" href="https://res.cloudinary.com" />
		<link rel="dns-prefetch" href="https://res.cloudinary.com">

		<link rel="canonical" href={canonicalURL.href} />

		<link rel="sitemap" href="/sitemap-index.xml" />
		{
			!index && 
				<meta name="robots" content="noindex, nofollow" />
				<meta name="googlebot" content="noindex, follow" />

		}
		{
			index && 
				<meta name="robots" content="index, follow" />
				<meta name="googlebot" content="index, follow" />
		}

		<!-- <link rel="preload" href="/fonts/main.woff2" as="font" type="font/woff2" crossorigin> -->
		{
			hero && <link rel="preload" as="image" href={hero} fetchpriority="high"/>
		}
		
	
		<meta name="description" content={description} />
		<link rel="icon" href="/logo.webp" />
		<meta name="color-scheme" content="only light">

		<!-- Open Graph tags -->
		<meta name="og:image" content={image} />
		<meta name="og:title" content={title} />
		<meta name="og:description" content={description} />
		<meta name="og:url" content={canonicalURL.href} />
		<meta name="og:site_name" content={title} />
		<meta name="og:type" content="website" />
		<meta name="og:locale" content="es_CO" />

		<!-- Schema Rich Results -->
		<script type="application/ld+json" set:html={JSON.stringify(OrganizationSchema)} />
		<Schemas schemas={schemas}/>

		<!-- Web analytics -->
		<SpeedInsights />
		<Analytics />
	</head>
	<body>
		<AnnouncementBar />
		<NavMenu />
		<CartDialog />
		<slot />

		<Footer />
	</body>
</html>

<style is:global>
	@import "tailwindcss";
	:root {

	color-scheme: only light;
	--brand: #c8774a;
	--on-brand: #FFFFFF;
	--brand-hover: #9A601D;

	--accent: #be1419;
	/* --accent: #dcdcdc; */
	--on-accent: #ffffff;


	--neutral-0: #ffffff;
	--neutral-900: #1A1A1A;

	--color-bg: #000000;
	--color-bg: #f5f5f5;
	--color-bg-secondary: #F4F3ED;
	--color-text: black;

	--menu-bg: #000000;
	--menu-text: #ffffff;

	--primary-color: #007bff;
	--secondary-color: #6c757d;
	}
	html,
	body {
		margin: 0 auto;
		padding: 0;
		scroll-behavior: smooth;
		width: 100%;
        height: 100%;
		background-color: var(--color-bg);
		font-family: Poppins, sans-serif;
	}
	button {
        touch-action: manipulation;
        cursor: pointer;
    }
</style>
