---
import { getCategoriesWithSlug } from "@lib/builder.js";
import FilterSVG from "@assets/filter.svg"

const categories = getCategoriesWithSlug();
---

<aside class="filter-container flex justify-end items-center gap-2 reverse mb-2">
	<label for="category-filter" class="flex items-center justify-center gap-2">
		
		<span class="rounded border border-black px-2 py-px opacity-80">
			<FilterSVG class="w-5 h-5 inline"/> Filtro
		</span>

		<select id="category-filter" name="category-filter" class="filter-select order-first">
			<option value="">Todos los modelos</option>
			{
				categories.map((category) => (
					<option value={category.slug}>{category.name}</option>
				))
			}
		</select>
	</label>
</aside>