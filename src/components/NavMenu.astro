---
import MenuIcon from "../assets/menu.svg";
import CartIcon from "../assets/cart.svg";
import CrossIcon from "../assets/cross.svg";

import { getCategoriesWithSlug } from "@lib/builder";
const logotipo = "/nav-logo-parrillas-y-defensas";
const categories = getCategoriesWithSlug();
---

<menu class="flex w-full items-center justify-between px-2.5 text-(--menu-text) bg-black m-0 box-border fixed top-8 z-100">

	<div class="flex items-center gap-2">
		<button
			class="block border-0 bg-transparent cursor-pointer"
			id="open-sidebar-button"
			aria-label="open sidebar"
			aria-expanded="false"
			aria-controls="navbar"
		>
			<MenuIcon width="28px" height="28px" />
		</button>
	</div>

	<a href="/" class="block text-xl font-bold" >
		<img src={logotipo} alt="Parrillas y Defensas Para Tu Moto" width="180px" height="60px" fetchpriority="high" />
	</a>

	<div class="flex items-center gap-2">
		<button
			class="block border-0 bg-transparent cursor-pointer"
			id="open-cart-button"	
			aria-label="abrir carrito"
			aria-expanded="false"
			aria-controls="carrito"
		>
			<span class="cart-button">
				<CartIcon width="25px" height="25px" />
				<span id="cart-badge" class="cart-badge" aria-label="items in cart">0</span>
			</span>
		</button>
	</div>

	<nav id="navbar" class="text-2xl">
		<ul>
			<li>
				<button
					id="close-sidebar-button"
					aria-label="close sidebar"
				>
					<CrossIcon width="30px" height="30px" />
				</button>
			</li>

			<li>
				<a href="/">Inicio</a>
			</li>
			
			{
				categories.map((category) => (
					<li>
						<a href={`/productos/?categoria=${category.slug}`}>{category.name}</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div id="overlay" aria-hidden="true"></div>
</menu>

<style>
	@import "tailwindcss";

	menu {
		@apply mx-auto;
	}
	button{
		@apply cursor-pointer flex items-center;
	}

	nav {
		display: none;
		position: fixed;
		top: 0;
		left: -0;
		height: 100vh;
		width: min(15em, fit-content);
		z-index: 10;
		border-left: 1px solid var(--hover-color);
		background-color: var(--menu-bg);
		color: var(--menu-text);

	}
	nav.show ~ #overlay {
		background: rgba(0, 0, 0, 0.5);
		position: fixed;
		inset: 0;
		z-index: 9;
		display: block;
	}


	ul {
		@apply flex flex-col pl-3 pr-6 py-6 ;
	}
	.show {
		display: block;
	}
	#overlay {
		display: none;
	}

	.cart-button {
		position: relative;
		display: inline-flex;
		align-items: center;
	}
	.cart-badge {
		position: absolute;
		top: -6px;
		right: -8px;
		min-width: 16px;
		height: 16px;
		padding: 0 4px;
		border-radius: 999px;
		background: #ef4444;
		color: white;
		font-size: 11px;
		line-height: 16px;
		text-align: center;
		font-weight: 700;
	}

	li a {
		@apply block font-medium w-full py-2;
	}

</style>

<script src="/src/scripts/navMenu.js"></script>