---
import { getCldImageUrl } from 'astro-cloudinary/helpers';
const { media } = Astro.props;
---

<div class="wrapper flex w-full snap-x snap-mandatory gap-5 overflow-x-scroll">
	{
        media.map((mediaSrc, i) => (
            <div class="card snap-center w-full max-w-125 shrink-0 box-border flex flex-col justify-center items-center text-center gap-2.5 aspect-square bg-white">
                <img src={getCldImageUrl({ src: mediaSrc, width: 1200, height: 1200 })} alt="" />
            </div>
        ))
    }
<!-- transition:name={`img-${mediaSrc}-${i}`} -->
</div>

<style>
	.wrapper {
		scroll-marker-group: after;
		scroll-behavior: smooth;
	}
	.wrapper::scroll-marker-group {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.5rem;
	}

	.card::scroll-marker {
		content: '';
		display: block;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background-color: black;
		flex-shrink: 0;
	}

	.card::scroll-marker:target-current {
		background-color: var(--accent);
	}

	img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}
</style>    