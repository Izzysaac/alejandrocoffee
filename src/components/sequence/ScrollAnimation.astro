---
export interface Props {
  sequencePath?: string;
  frameCount?: number;
  aspectRatio?: number;
  scrollLengthVh?: number;
}

const { 
  sequencePath = "/sequence", 
  frameCount = 210, 
  aspectRatio = 16/9,
  scrollLengthVh = 600
} = Astro.props;
---

<div class="scroll-container" data-sequence-container>
  <div class="loading-indicator" data-sequence-loading>
    <div class="loading-text">Loading frames...</div>
    <div class="loading-progress" data-sequence-progress>0%</div>
  </div>
  <canvas class="sequence-canvas" data-sequence-canvas></canvas>
</div>

<style>

  .scroll-container {
    height: 600vh;
    position: relative;
    background: #000;
    margin: 0;
    padding: 0;
  }

  .sequence-canvas {
    position: sticky;
    top: 0;
    width: 100vw;
    height: 100vh;
    display: block;
    margin: 0;
    padding: 0;
  }

  .loading-indicator {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: white;
    font-family: system-ui, -apple-system, sans-serif;
    z-index: 1000;
  }

  .loading-text {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .loading-progress {
    font-size: 2rem;
    font-weight: bold;
  }
</style>

<script define:vars={{ sequencePath, frameCount, aspectRatio, scrollLengthVh }} is:inline>
  const container = document.querySelector('[data-sequence-container]');
  const canvas = container?.querySelector('[data-sequence-canvas]');
  const loading = container?.querySelector('[data-sequence-loading]');
  const progressEl = container?.querySelector('[data-sequence-progress]');

  if (!(container instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement) || !(loading instanceof HTMLElement) || !(progressEl instanceof HTMLElement)) {
    throw new Error('Sequence component: required elements not found');
  }

  container.style.height = `${Number(scrollLengthVh) || 600}vh`;

  const ctx = canvas.getContext('2d');
  if (!ctx) {
    throw new Error('Sequence component: 2D context not available');
  }

  const frames = new Array(frameCount);
  let loaded = 0;
  let currentFrame = -1;
  let rafId = 0;
  let rafScheduled = false;
  let dpr = window.devicePixelRatio || 1;

  function frameUrl(i) {
    const frameNumber = String(i + 1).padStart(3, '0');
    return `${sequencePath}/ezgif-frame-${frameNumber}.jpg`;
  }

  function setProgress() {
    const pct = Math.round((loaded / frameCount) * 100);
    progressEl.textContent = `${pct}%`;
  }

  function resizeCanvas() {
    dpr = window.devicePixelRatio || 1;
    const cssW = window.innerWidth;
    const cssH = window.innerHeight;

    canvas.style.width = `${cssW}px`;
    canvas.style.height = `${cssH}px`;

    const nextW = Math.floor(cssW * dpr);
    const nextH = Math.floor(cssH * dpr);
    if (canvas.width !== nextW || canvas.height !== nextH) {
      canvas.width = nextW;
      canvas.height = nextH;
    }

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function getScrollProgress() {
    const rect = container.getBoundingClientRect();
    const total = container.offsetHeight - window.innerHeight;
    if (total <= 0) return rect.top <= 0 ? 1 : 0;
    const scrolled = -rect.top;
    return Math.max(0, Math.min(1, scrolled / total));
  }

  function drawFrame(index) {
    const img = frames[index];
    if (!(img instanceof HTMLImageElement) || !img.complete) return;

    const cssW = canvas.width / dpr;
    const cssH = canvas.height / dpr;
    ctx.clearRect(0, 0, cssW, cssH);

    const imgAR = img.width / img.height;
    const viewAR = cssW / cssH;
    let drawW;
    let drawH;
    if ((aspectRatio || imgAR) > viewAR) {
      drawW = cssW;
      drawH = cssW / (aspectRatio || imgAR);
    } else {
      drawH = cssH;
      drawW = cssH * (aspectRatio || imgAR);
    }
    const x = (cssW - drawW) / 2;
    const y = (cssH - drawH) / 2;
    ctx.drawImage(img, x, y, drawW, drawH);
  }

  function update() {
    rafScheduled = false;
    const progress = getScrollProgress();
    const next = Math.max(0, Math.min(frameCount - 1, Math.round(progress * (frameCount - 1))));
    if (next !== currentFrame) {
      currentFrame = next;
      drawFrame(currentFrame);
    }
  }

  function requestUpdate() {
    if (rafScheduled) return;
    rafScheduled = true;
    rafId = requestAnimationFrame(update);
  }

  function preload() {
    setProgress();
    resizeCanvas();

    for (let i = 0; i < frameCount; i++) {
      const img = new Image();
      frames[i] = img;
      img.onload = () => {
        loaded += 1;
        setProgress();

        if (loaded === 1) {
          loading.style.display = 'none';
          currentFrame = 0;
          drawFrame(0);
          requestUpdate();
        }
      };
      img.onerror = () => {
        loaded += 1;
        setProgress();
      };
      img.src = frameUrl(i);
    }
  }

  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', () => {
    resizeCanvas();
    requestUpdate();
  });

  preload();
</script>
