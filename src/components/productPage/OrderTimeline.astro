---
import Shop from "../../assets/shop.svg";
import Box from "../../assets/box.svg";
import OrderDelivery from "../../assets/orderDelivery.svg";
---

<div class="container-order-checkpoint py-2">
	<div class="timeline">&nbsp;</div>
	<div>
		<div class="icon">
			<Shop />
		</div>
		<p>
			<span id="order-date" class="">Compra Hoy</span>
			<span class="poppins-regular">Pedido confirmado</span>
		</p>
	</div>
	<div>
		<div class="icon">
			<OrderDelivery />
		</div>
		<p>
			<span id="personalization-date" class=""
				>Fecha de personalización</span
			>
			<span class="poppins-regular">Pedido enviado</span>
		</p>
	</div>
	<div>
		<div class="icon">
			<Box />
		</div>
		<p>
			<span id="delivery-date" class="">Fecha de entrega</span>
			<span class="poppins-regular">
				Fecha de entrega
				<button
					id="info-btn"
					class="relative"
					aria-label="Información de envío"
				>
					ⓘ
					<div
						id="tooltip"
						class="pointer-events-none absolute right-1/2 bottom-full z-50 mb-2 hidden w-48 translate-x-1/12 rounded bg-gray-800 p-2 text-xs text-white shadow-lg"
					>
						Fecha estimada de entrega. Los tiempos pueden variar según la disponibilidad de la transportadora.
						<div
							class="absolute top-full left-11/12 -translate-x-1/2 border-8 border-transparent border-t-gray-800"
						>
						</div>
					</div>
				</button>
			</span>
		</p>
	</div>
</div>
<style>
	.container-order-checkpoint {
		width: 100%;
		display: flex;
		justify-content: space-between;
		position: relative;
		color: rgb(14, 14, 14);
		> div {
			display: flex;
			flex-direction: column;
			align-items: center;
		}
	}
	.icon {
		border: 2px solid black;
		border-radius: 50%;
		aspect-ratio: 1 / 1;
		padding: 12px;
		width: fit-content;
		background-color: white;
	}
	.timeline {
		height: 3px;
		background-color: black;
		position: absolute;
		top: 25px;
		left: 50%;
		transform: translateX(-50%);
		width: 70%;
		z-index: -1;
	}
	p {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
		text-align: center;
		font-size: 13px;
		margin-top: 4px;

		span:first-child {
			line-height: 1.2;
			font-size: 14px;
			font-weight: bold;
		}
		span:last-child {
			line-height: 1.2;
			font-size: 12px;
		}
	}
</style>

<script is:inline>
	const obtenerFechas = (diasArray) => {
		const hoy = new Date();

		return diasArray.map((diasHabiles) => {
			const fecha = new Date(hoy);
			let restantes = diasHabiles;

			while (restantes > 0) {
				fecha.setDate(fecha.getDate() + 1);

				const diaSemana = fecha.getDay();
				if (diaSemana !== 0 && diaSemana !== 6) {
					restantes--;
				}
			}

			// Si hoy cae en fin de semana y se pide 0 días hábiles,
			// avanzar hasta el siguiente día hábil.
			while (fecha.getDay() === 0 || fecha.getDay() === 6) {
				fecha.setDate(fecha.getDate() + 1);
			}

			return fecha.toLocaleDateString("es-CO", {
				day: "numeric",
				month: "long",
			});
		});
	};

	const dias = [0, 1, 3];
	const resultado = obtenerFechas(dias);

	const orderDate = document.getElementById("order-date");
	const personalizationDate = document.getElementById(
		"personalization-date",
	);
	const deliveryDate = document.getElementById("delivery-date");

	orderDate.textContent = resultado[0];
	personalizationDate.textContent = resultado[1];
	deliveryDate.textContent = resultado[2];
</script>

<script is:inline>
	const infoBtn = document.getElementById("info-btn");
	const tooltip = document.getElementById("tooltip");

	if (infoBtn && tooltip) {
		// Mostrar / Ocultar al tocar el icono
		infoBtn.addEventListener("click", (e) => {
			e.stopPropagation(); // Evita que el click suba al document
			tooltip.classList.toggle("hidden");
		});

		// Cerrar si el usuario toca en cualquier otra parte de la pantalla
		document.addEventListener("click", () => {
			tooltip.classList.add("hidden");
		});
	}
</script>